# Vestigium Phase 2 Pipeline Configuration

# Choose LLM Provider: 'openai', 'gemini', or 'mock' (default: mock if no keys are set)
LLM_PROVIDER=mock

# Model selection
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# API Keys (Provide one of these to run live extractions with real LLMs)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: NVD API Key for higher rate limits (not strictly required for small batches)
NVD_API_KEY=
